<!-- app_server/views/rooms.hbs -->
{{> header}}

<div id="contents">
  <div class="box">
    <div>
      <div class="body">
        <h1>Rooms</h1>
        <ul id="rooms">
          {{#each rooms}}
          <li>
            <a href="/rooms"><img src="{{this.image}}" alt="{{this.name}}"></a>
            <h2><a href="/rooms">{{this.name}}</a></h2>
            <p>{{this.description}}</p>
            {{#if this.rate}}<span class="rate">{{this.rate}}</span>{{/if}}
          </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</div>

{{> footer}}
