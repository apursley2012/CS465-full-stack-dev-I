<!-- app_server/views/meals.hbs -->
{{> header}}

<div id="contents">
  <div class="box">
    <div>
      <div class="body">
        <h1>Meals</h1>
        <ul id="foods">
          {{#each meals}}
          <li>
            <h2><a href="/meals">{{this.name}}</a></h2>
            <div class="infos">
              <a href="/meals"><img src="{{this.image}}" alt="{{this.name}}" height="169" width="780"></a>
              <p><span>{{this.description}}</span> {{this.details}}</p>
            </div>
          </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</div>

{{> footer}}
