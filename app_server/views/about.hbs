<!-- app_server/views/about.hbs -->
{{> header}}

<div id="contents">
  <div class="box">
    <div>
      <div class="body">
        <h1>{{title}}</h1>
        <h2>{{heading}}</h2>

        {{#each content}}
          {{#if (eq this.type "paragraph")}}<p>{{this.text}}</p>{{/if}}
        {{/each}}

        {{#each sections}}
          <h2>{{this.title}}</h2>
          <p>{{this.description}}</p>
        {{/each}}

        {{#if community}}
          <h2>{{community.title}}</h2>
          <p>{{community.text}}</p>
        {{/if}}

        {{#if templateDetails}}
          <h2>{{templateDetails.title}}</h2>
          <p>{{templateDetails.text}}</p>
        {{/if}}
      </div>
    </div>
  </div>
</div>

{{> footer}}
