<!-- app_server/views/news.hbs -->
{{> header}}

<div id="contents">
  <div class="box">
    <div class="sidebar">
      <h3>Latest News</h3>
      <ul>
        {{#each latestNews}}
          <li><a href="{{this.url}}">{{this.title}}</a></li>
        {{/each}}
      </ul>

      <h3>Vacation Tips</h3>
      <ul>
        {{#each vacationTips}}
          <li><a href="{{this.url}}">{{this.title}}</a></li>
        {{/each}}
      </ul>
    </div>

    <div class="body">
      <h1>{{article.title}}</h1>
      {{#if article.image}}<img src="{{article.image}}" alt="{{article.title}}">{{/if}}
      <p><em>{{article.date}}</em> by {{article.author}}</p>
      {{#each article.content}}<p>{{this}}</p>{{/each}}
    </div>
  </div>
</div>

{{> footer}}
